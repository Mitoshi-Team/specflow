# Порт, на котором nginx доступен снаружи (http://localhost:<NGINX_PORT>).
NGINX_PORT=80

# Базовый URL API для фронтенда. Пусто — запросы идут на тот же origin через nginx.
VITE_API_BASE_URL=

# Источники, разрешённые для CORS в API Gateway (JSON-массив).
API_GATEWAY_CORS_ORIGINS=["http://localhost","http://localhost:5173"]
