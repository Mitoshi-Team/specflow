# --- Общие настройки -------------------------------------------------------

# Порт, на котором nginx доступен снаружи (http://localhost:<NGINX_PORT>).
NGINX_PORT=80

# Базовый URL API для фронтенда. Пусто — запросы идут на тот же origin через nginx.
VITE_API_BASE_URL=

# --- API Gateway (переменные с префиксом API_GATEWAY_) ----------------------

# Источники, разрешённые для CORS в API Gateway (JSON-массив).
API_GATEWAY_CORS_ORIGINS=["http://localhost","http://localhost:5173"]

# Базовый URL сервиса извлечения атрибутов внутри docker-сети.
API_GATEWAY_ATTRIBUTE_EXTRACTOR_URL=http://attribute_extractor:8001

# Таймаут запросов к сервису извлечения атрибутов, в секундах.
API_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=60

# --- Attribute Extractor (переменные с префиксом EXTRACTOR_) ----------------

# Версия пайплайна, проставляется в ответах API.
EXTRACTOR_PIPELINE_VERSION=0.1.0

# Порог уверенности, начиная с которого значение считается надёжным.
EXTRACTOR_DEFAULT_CONFIDENCE_THRESHOLD=0.80

# Порог уверенности, ниже которого значение требует ручной проверки.
EXTRACTOR_REVIEW_CONFIDENCE_THRESHOLD=0.60

# Максимальное число карточек в одном пакетном запросе.
EXTRACTOR_MAX_BATCH_SIZE=50

# Стратегия гибридного каскада экстракторов (дешёвые методы первыми).
EXTRACTOR_HYBRID_STRATEGY=cascade_cheap_first

# Обязательная проверка подтверждения значения в тексте карточки (grounding).
EXTRACTOR_GROUNDING_REQUIRED=true

# Нормализация значений и приведение единиц измерения.
EXTRACTOR_NORMALIZATION_ENABLED=true
EXTRACTOR_UNIT_CONVERSION_ENABLED=true

# Строгая проверка значений enum по справочнику (отбрасывать значения вне словаря).
EXTRACTOR_ENUM_STRICT=false

# Внешняя LLM. По умолчанию выключена: базовый режим работает на правилах и словарях.
EXTRACTOR_ENABLE_LLM=false
EXTRACTOR_LLM_PROVIDER=openrouter
EXTRACTOR_LLM_MODEL=
EXTRACTOR_LLM_API_KEY=
EXTRACTOR_LLM_TEMPERATURE=0.0
EXTRACTOR_LLM_MAX_TOKENS=1200
